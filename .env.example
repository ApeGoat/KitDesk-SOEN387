# Copy to .env and change the values. .env is git-ignored; never commit it.
DB_USER=kitdesk
DB_PASSWORD=change-me
# Signs login tokens. Use a long random string, at least 32 characters, e.g. from: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# "demo" (the default in docker-compose) loads the demo accounts, which all use the password
# "password". Set it to anything else, e.g. "prod", to start with no accounts.
SPRING_PROFILES_ACTIVE=demo
